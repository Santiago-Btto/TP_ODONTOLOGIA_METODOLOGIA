# Valores de desarrollo local. Nunca poner credenciales reales en este archivo.
DATABASE_URL=postgresql+psycopg://turnos:turnos@localhost:5432/turnos
TEST_DATABASE_URL=postgresql+psycopg://turnos:turnos@localhost:5432/turnos_test

# Firma de los JWT (C-08). Obligatorio, mínimo 32 caracteres; la API no inicia sin él.
# Generar uno propio y NO versionarlo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Vida de los tokens de acceso, en minutos.
JWT_EXPIRA_MINUTOS=30
